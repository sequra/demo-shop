#!/usr/bin/env bash
#
# Shared post-checkout hook.
#
# setup.sh points core.hooksPath at .githooks, so git no longer runs anything
# under .git/hooks. Chain to a local post-checkout hook if present — e.g.
# graphify's knowledge-graph rebuild (`graphify hook install`). No-op when
# nothing is installed.

set -uo pipefail

git_dir="$(git rev-parse --git-dir)"
local_hook="$git_dir/hooks/post-checkout"

if [ -x "$local_hook" ]; then
    exec "$local_hook" "$@"
fi
