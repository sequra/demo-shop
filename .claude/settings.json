{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose exec sequra_demo_shop:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(php -l:*)",
      "Bash(php bin/init-data.php:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git --version)",
      "Bash(git add:*)",
      "Skill(sq-git:commit)",
      "Skill(sq-git:open-pr)",
      "Skill(sq-git:sync-branch)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(./setup.sh:*)",
      "Bash(git push:*)"
    ]
  }
}
